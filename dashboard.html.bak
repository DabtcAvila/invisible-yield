<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invisible Yield - Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://unpkg.com/get-starknet/dist/index.global.js"></script>
    <script type="module" src="https://unpkg.com/starknet@5.24.3/dist/index.js"></script>
    <script type="module" src="starknet-integration.js"></script>
</head>
<body class="bg-black text-white">
    <div class="min-h-screen bg-gradient-to-b from-black via-green-950 to-black">
        <!-- Header -->
        <header class="bg-black/80 backdrop-blur-lg border-b border-emerald-900/30 p-4">
            <div class="container mx-auto flex justify-between items-center">
                <h1 class="text-2xl font-bold bg-gradient-to-r from-green-400 to-emerald-400 bg-clip-text text-transparent">
                    Invisible Yield Dashboard
                </h1>
                <div class="flex items-center gap-4">
                    <span class="text-sm text-gray-400">Connected:</span>
                    <span id="user-address" class="font-mono text-xs text-green-400">Connecting...</span>
                    <div id="network-indicator" class="px-2 py-1 bg-green-600/20 border border-green-600 rounded text-xs">
                        Mainnet
                    </div>
                    <button onclick="disconnect()" class="px-4 py-2 bg-red-600/20 border border-red-600 rounded-lg hover:bg-red-600/30">
                        Disconnect
                    </button>
                </div>
            </div>
        </header>

        <!-- Stats -->
        <div class="container mx-auto p-6">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
                <div class="bg-black/50 backdrop-blur border border-emerald-900/30 rounded-xl p-6">
                    <p class="text-gray-400 text-sm mb-2">Your Balance</p>
                    <p id="total-balance" class="text-3xl font-bold text-green-400">Loading...</p>
                    <p id="balance-change" class="text-xs text-green-500 mt-2">+12.5% this month</p>
                </div>
                <div class="bg-black/50 backdrop-blur border border-emerald-900/30 rounded-xl p-6">
                    <p class="text-gray-400 text-sm mb-2">Current APY</p>
                    <p id="current-apy" class="text-3xl font-bold text-emerald-400">Loading...</p>
                    <p class="text-xs text-gray-500 mt-2">Auto-compounding</p>
                </div>
                <div class="bg-black/50 backdrop-blur border border-emerald-900/30 rounded-xl p-6">
                    <p class="text-gray-400 text-sm mb-2">Total Earned</p>
                    <p id="total-earned" class="text-3xl font-bold text-blue-400">Loading...</p>
                    <p class="text-xs text-gray-500 mt-2">Since deposit</p>
                </div>
                <div class="bg-black/50 backdrop-blur border border-emerald-900/30 rounded-xl p-6">
                    <p class="text-gray-400 text-sm mb-2">Next Compound</p>
                    <p id="next-compound" class="text-3xl font-bold text-yellow-400">2h 34m</p>
                    <p class="text-xs text-gray-500 mt-2">Automatic</p>
                </div>
            </div>

            <!-- Actions -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                <button id="deposit-btn" onclick="deposit()" class="p-6 bg-gradient-to-r from-green-600 to-emerald-600 rounded-xl font-bold text-lg hover:scale-105 transition disabled:opacity-50 disabled:cursor-not-allowed">
                    💰 Deposit
                </button>
                <button id="withdraw-btn" onclick="withdraw()" class="p-6 bg-black/50 border-2 border-emerald-500 rounded-xl font-bold text-lg hover:bg-emerald-950/30 transition disabled:opacity-50 disabled:cursor-not-allowed">
                    💸 Withdraw
                </button>
                <button id="compound-btn" onclick="compound()" class="p-6 bg-black/50 border-2 border-blue-500 rounded-xl font-bold text-lg hover:bg-blue-950/30 transition disabled:opacity-50 disabled:cursor-not-allowed">
                    🔄 Compound Now
                </button>
            </div>
            
            <!-- Token Balances -->
            <div class="bg-black/50 backdrop-blur border border-emerald-900/30 rounded-xl p-6 mb-8">
                <h2 class="text-xl font-bold mb-4">Token Balances</h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="bg-black/30 rounded-lg p-4">
                        <div class="flex justify-between items-center">
                            <div>
                                <p class="font-semibold">USDC</p>
                                <p class="text-sm text-gray-400">USD Coin</p>
                            </div>
                            <div class="text-right">
                                <p id="usdc-balance" class="font-bold">Loading...</p>
                                <p id="usdc-value" class="text-sm text-gray-400">$0.00</p>
                            </div>
                        </div>
                    </div>
                    <div class="bg-black/30 rounded-lg p-4">
                        <div class="flex justify-between items-center">
                            <div>
                                <p class="font-semibold">ETH</p>
                                <p class="text-sm text-gray-400">Ethereum</p>
                            </div>
                            <div class="text-right">
                                <p id="eth-balance" class="font-bold">Loading...</p>
                                <p id="eth-value" class="text-sm text-gray-400">$0.00</p>
                            </div>
                        </div>
                    </div>
                    <div class="bg-black/30 rounded-lg p-4">
                        <div class="flex justify-between items-center">
                            <div>
                                <p class="font-semibold">STRK</p>
                                <p class="text-sm text-gray-400">StarkNet Token</p>
                            </div>
                            <div class="text-right">
                                <p id="strk-balance" class="font-bold">Loading...</p>
                                <p id="strk-value" class="text-sm text-gray-400">$0.00</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Chart -->
            <div class="bg-black/50 backdrop-blur border border-emerald-900/30 rounded-xl p-6 mb-8">
                <h2 class="text-xl font-bold mb-4">Portfolio Growth</h2>
                <div style="position: relative; height: 300px;">
                    <canvas id="growthChart"></canvas>
                </div>
            </div>

            <!-- Yield Strategies -->
            <div class="bg-black/50 backdrop-blur border border-emerald-900/30 rounded-xl p-6 mb-8">
                <h2 class="text-xl font-bold mb-4">Active Yield Strategies</h2>
                <div id="yield-strategies" class="space-y-4">
                    <div class="flex justify-between items-center p-4 bg-black/30 rounded-lg">
                        <div>
                            <p class="font-semibold">zkLend USDC Vault</p>
                            <p class="text-sm text-gray-400">Low Risk • Auto-compound</p>
                        </div>
                        <div class="text-right">
                            <p id="conservative-apy" class="text-green-400 font-bold">Loading...</p>
                            <p class="text-sm text-gray-400">40% allocation</p>
                        </div>
                    </div>
                    <div class="flex justify-between items-center p-4 bg-black/30 rounded-lg">
                        <div>
                            <p class="font-semibold">JediSwap LP Strategy</p>
                            <p class="text-sm text-gray-400">Medium Risk • Weekly rebalance</p>
                        </div>
                        <div class="text-right">
                            <p id="balanced-apy" class="text-emerald-400 font-bold">Loading...</p>
                            <p class="text-sm text-gray-400">35% allocation</p>
                        </div>
                    </div>
                    <div class="flex justify-between items-center p-4 bg-black/30 rounded-lg">
                        <div>
                            <p class="font-semibold">Nostra STRK Mining</p>
                            <p class="text-sm text-gray-400">High Risk • Daily harvest</p>
                        </div>
                        <div class="text-right">
                            <p id="aggressive-apy" class="text-yellow-400 font-bold">Loading...</p>
                            <p class="text-sm text-gray-400">25% allocation</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Transaction History -->
            <div class="bg-black/50 backdrop-blur border border-emerald-900/30 rounded-xl p-6">
                <h2 class="text-xl font-bold mb-4">Recent Transactions</h2>
                <div id="transaction-history" class="space-y-4">
                    <p class="text-gray-400 text-center py-4">Loading transaction history...</p>
                </div>
            </div>
        </div>
    </div>

    <script type="module">
        import InvisibleYieldStarkNet from './starknet-integration.js';
        
        // Global state
        let portfolio = null;
        let chartInstance = null;
        let isLoading = false;
        let userAddress = null;
        let pendingTransactions = [];
        
        // Initialize dashboard
        window.addEventListener('DOMContentLoaded', async () => {
            console.log('📊 Initializing Invisible Yield Dashboard...');
            
            try {
                await initializeWallet();
                await loadPortfolioData();
                await loadYieldRates();
                await loadTransactionHistory();
                initChart();
                startRealTimeUpdates();
            } catch (error) {
                console.error('Dashboard initialization failed:', error);
                showNotification('Failed to connect to wallet. Please reconnect.', 'error');
                setTimeout(() => {
                    window.location.href = 'wallet-connect.html';
                }, 3000);
            }
        });
        
        // Initialize wallet connection
        async function initializeWallet() {
            try {
                // Check for existing wallet connection
                const starknet = globalThis.starknet;
                if (!starknet || !starknet.isConnected) {
                    throw new Error('No wallet connected');
                }
                
                const result = await window.InvisibleYield.connectWallet();
                if (!result.success) {
                    throw new Error('Failed to connect wallet');
                }
                
                userAddress = result.address;
                
                // Update UI
                document.getElementById('user-address').textContent = userAddress.slice(0, 8) + '...' + userAddress.slice(-4);
                document.getElementById('network-indicator').textContent = result.isTestnet ? 'Sepolia' : 'Mainnet';
                
                console.log('✅ Wallet connected:', userAddress);
                
            } catch (error) {
                console.error('Wallet initialization failed:', error);
                throw error;
            }
        }
        
        // Load portfolio data from blockchain
        async function loadPortfolioData() {
            try {
                console.log('📊 Loading portfolio data...');
                
                portfolio = window.InvisibleYield.portfolio;
                const balances = await window.InvisibleYield.getTokenBalances();
                
                // Update main stats
                document.getElementById('total-balance').textContent = '$' + balances.totalValue.toLocaleString(undefined, {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
                
                document.getElementById('total-earned').textContent = '$' + (portfolio.totalEarned || 0).toLocaleString(undefined, {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
                
                document.getElementById('current-apy').textContent = (portfolio.currentAPY || 0).toFixed(1) + '%';
                
                // Update token balances
                document.getElementById('usdc-balance').textContent = balances.USDC.balance.toFixed(2);
                document.getElementById('usdc-value').textContent = '$' + balances.USDC.value.toFixed(2);
                
                document.getElementById('eth-balance').textContent = balances.ETH.balance.toFixed(4);
                document.getElementById('eth-value').textContent = '$' + balances.ETH.value.toFixed(2);
                
                document.getElementById('strk-balance').textContent = balances.STRK.balance.toFixed(2);
                document.getElementById('strk-value').textContent = '$' + balances.STRK.value.toFixed(2);
                
                console.log('✅ Portfolio data loaded');
                
            } catch (error) {
                console.error('Failed to load portfolio data:', error);
                showNotification('Failed to load portfolio data', 'error');
            }
        }
        
        // Load current yield rates from protocols
        async function loadYieldRates() {
            try {
                console.log('📈 Loading yield rates...');
                
                const yieldData = await window.InvisibleYield.getYieldData();
                
                // Update strategy APYs
                document.getElementById('conservative-apy').textContent = yieldData.zkLend.USDC.toFixed(1) + '% APY';
                document.getElementById('balanced-apy').textContent = yieldData.jediSwap['ETH/USDC'].toFixed(1) + '% APY';
                document.getElementById('aggressive-apy').textContent = yieldData.jediSwap['STRK/ETH'].toFixed(1) + '% APY';
                
                console.log('✅ Yield rates loaded');
                
            } catch (error) {
                console.error('Failed to load yield rates:', error);
            }
        }
        
        // Load transaction history
        async function loadTransactionHistory() {
            try {
                console.log('📝 Loading transaction history...');
                
                const historyContainer = document.getElementById('transaction-history');
                
                // Mock transaction history - replace with real blockchain queries
                const transactions = [
                    {
                        type: 'deposit',
                        amount: '5000 USDC',
                        hash: '0x1234...abcd',
                        timestamp: new Date(Date.now() - 86400000),
                        status: 'confirmed'
                    },
                    {
                        type: 'compound',
                        amount: '125.50 USDC',
                        hash: '0x5678...efgh',
                        timestamp: new Date(Date.now() - 172800000),
                        status: 'confirmed'
                    },
                    {
                        type: 'deposit',
                        amount: '2.5 ETH',
                        hash: '0x9abc...ijkl',
                        timestamp: new Date(Date.now() - 259200000),
                        status: 'confirmed'
                    }
                ];
                
                historyContainer.innerHTML = transactions.map(tx => `
                    <div class="flex justify-between items-center p-4 bg-black/30 rounded-lg">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 ${
                                tx.type === 'deposit' ? 'bg-green-600' :
                                tx.type === 'withdraw' ? 'bg-red-600' :
                                'bg-blue-600'
                            } rounded-full flex items-center justify-center">
                                <span class="text-xs font-bold">${
                                    tx.type === 'deposit' ? '↓' :
                                    tx.type === 'withdraw' ? '↑' :
                                    '↻'
                                }</span>
                            </div>
                            <div>
                                <p class="font-semibold capitalize">${tx.type}</p>
                                <p class="text-sm text-gray-400">${tx.timestamp.toLocaleDateString()}</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="font-bold">${tx.amount}</p>
                            <a href="https://starkscan.co/tx/${tx.hash}" target="_blank" class="text-xs text-blue-400 hover:underline">
                                ${tx.hash}
                            </a>
                        </div>
                    </div>
                `).join('');
                
            } catch (error) {
                console.error('Failed to load transaction history:', error);
            }
        }
        
        // Initialize chart
        function initChart() {
            const ctx = document.getElementById('growthChart').getContext('2d');
            const chartData = [8000, 8500, 9200, 9800, 10200, portfolio?.totalValue || 10847];
            
            chartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
                    datasets: [{
                        label: 'Portfolio Value',
                        data: chartData,
                        borderColor: 'rgb(34, 197, 94)',
                        backgroundColor: 'rgba(34, 197, 94, 0.1)',
                        tension: 0.4,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        intersect: false
                    },
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: false,
                            grid: {
                                color: 'rgba(255, 255, 255, 0.1)'
                            },
                            ticks: {
                                color: 'rgba(255, 255, 255, 0.5)',
                                callback: function(value) {
                                    return '$' + value.toLocaleString();
                                }
                            }
                        },
                        x: {
                            grid: {
                                color: 'rgba(255, 255, 255, 0.1)'
                            },
                            ticks: {
                                color: 'rgba(255, 255, 255, 0.5)'
                            }
                        }
                    }
                }
            });
        }
        
        // Real deposit function
        window.deposit = async function() {
            if (isLoading) return;
            
            try {
                const amount = parseFloat(prompt('Enter deposit amount (USDC):'));
                if (!amount || isNaN(amount) || amount <= 0) return;
                
                const token = 'USDC';
                const strategy = 'balanced';
                
                setLoading(true);
                showNotification('Processing deposit transaction...', 'info');
                
                const result = await window.InvisibleYield.deposit(amount, token, strategy);
                
                if (result.success) {
                    showNotification(`✅ Deposited ${amount} ${token} successfully!`, 'success');
                    
                    // Add to pending transactions
                    pendingTransactions.push({
                        type: 'deposit',
                        amount: `${amount} ${token}`,
                        hash: result.txHash,
                        status: 'pending'
                    });
                    
                    // Refresh data
                    await loadPortfolioData();
                    await loadTransactionHistory();
                } else {
                    throw new Error('Transaction failed');
                }
                
            } catch (error) {
                console.error('Deposit failed:', error);
                showNotification('❌ Deposit failed: ' + error.message, 'error');
            } finally {
                setLoading(false);
            }
        };
        
        // Real withdraw function
        window.withdraw = async function() {
            if (isLoading) return;
            
            try {
                const amount = parseFloat(prompt('Enter withdrawal amount (USDC):'));
                if (!amount || isNaN(amount) || amount <= 0) return;
                
                const token = 'USDC';
                const strategy = 'balanced';
                
                setLoading(true);
                showNotification('Processing withdrawal transaction...', 'info');
                
                const result = await window.InvisibleYield.withdraw(amount, token, strategy);
                
                if (result.success) {
                    showNotification(`✅ Withdrew ${amount} ${token} successfully!`, 'success');
                    
                    // Refresh data
                    await loadPortfolioData();
                    await loadTransactionHistory();
                } else {
                    throw new Error('Transaction failed');
                }
                
            } catch (error) {
                console.error('Withdrawal failed:', error);
                showNotification('❌ Withdrawal failed: ' + error.message, 'error');
            } finally {
                setLoading(false);
            }
        };
        
        // Real compound function
        window.compound = async function() {
            if (isLoading) return;
            
            try {
                setLoading(true);
                showNotification('Compounding all yields...', 'info');
                
                const result = await window.InvisibleYield.compoundAll();
                
                if (result.success) {
                    showNotification('✅ All yields compounded successfully!', 'success');
                    
                    // Refresh data
                    await loadPortfolioData();
                    await loadTransactionHistory();
                } else {
                    throw new Error('Compound failed');
                }
                
            } catch (error) {
                console.error('Compound failed:', error);
                showNotification('❌ Compound failed: ' + error.message, 'error');
            } finally {
                setLoading(false);
            }
        };
        
        // Disconnect wallet
        window.disconnect = async function() {
            if (confirm('Are you sure you want to disconnect your wallet?')) {
                try {
                    await window.InvisibleYield.disconnectWallet();
                    window.location.href = 'index.html';
                } catch (error) {
                    console.error('Disconnect error:', error);
                }
            }
        };
        
        // Utility functions
        function setLoading(loading) {
            isLoading = loading;
            const buttons = ['deposit-btn', 'withdraw-btn', 'compound-btn'];
            buttons.forEach(id => {
                const btn = document.getElementById(id);
                btn.disabled = loading;
                if (loading) {
                    btn.innerHTML = btn.innerHTML.replace(/💰|💸|🔄/, '⏳');
                } else {
                    if (id === 'deposit-btn') btn.innerHTML = '💰 Deposit';
                    if (id === 'withdraw-btn') btn.innerHTML = '💸 Withdraw';
                    if (id === 'compound-btn') btn.innerHTML = '🔄 Compound Now';
                }
            });
        }
        
        function showNotification(message, type = 'info') {
            const notification = document.createElement('div');
            notification.className = `fixed top-4 right-4 p-4 rounded-lg z-50 max-w-sm ${
                type === 'success' ? 'bg-green-600' :
                type === 'error' ? 'bg-red-600' :
                type === 'warning' ? 'bg-yellow-600' :
                'bg-blue-600'
            } text-white shadow-lg`;
            notification.textContent = message;
            
            document.body.appendChild(notification);
            
            setTimeout(() => {
                notification.remove();
            }, 5000);
        }
        
        // Start real-time updates
        function startRealTimeUpdates() {
            // Update portfolio data every 30 seconds
            setInterval(async () => {
                if (!isLoading) {
                    await loadPortfolioData();
                    await loadYieldRates();
                }
            }, 30000);
            
            // Update compound timer
            setInterval(() => {
                const now = new Date();
                const nextCompound = new Date(now);
                nextCompound.setHours(nextCompound.getHours() + 2, 34, 0, 0);
                
                const diff = nextCompound - now;
                const hours = Math.floor(diff / (1000 * 60 * 60));
                const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                
                document.getElementById('next-compound').textContent = `${hours}h ${minutes}m`;
            }, 60000);
        }
    </script>
</body>
</html>