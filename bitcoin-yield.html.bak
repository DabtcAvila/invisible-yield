<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invisible Bitcoin Yield - Earn with BTC on StarkNet</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .bitcoin-gradient {
            background: linear-gradient(135deg, #f7931a 0%, #ff9500 50%, #f7931a 100%);
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
        .pulse { animation: pulse 2s infinite; }
    </style>
</head>
<body class="bg-black text-white">
    <div class="min-h-screen bg-gradient-to-b from-black via-orange-950/20 to-black">
        <!-- Header -->
        <header class="fixed top-0 w-full bg-black/80 backdrop-blur-lg z-50 border-b border-orange-900/30">
            <div class="container mx-auto px-4 py-4 flex justify-between items-center">
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 bitcoin-gradient rounded-xl flex items-center justify-center">
                        <span class="text-2xl font-bold text-white">₿</span>
                    </div>
                    <div>
                        <h1 class="text-xl font-bold text-orange-400">Invisible Bitcoin Yield</h1>
                        <p class="text-xs text-orange-300">Powered by Lightning + StarkNet</p>
                    </div>
                </div>
                <nav class="hidden md:flex items-center gap-6">
                    <button onclick="connectLightning()" class="px-6 py-2 bitcoin-gradient text-white rounded-lg font-semibold hover:scale-105 transition">
                        ⚡ Connect Lightning
                    </button>
                </nav>
            </div>
        </header>

        <!-- Hero Section -->
        <main class="pt-24">
            <section class="container mx-auto px-4 py-20 text-center">
                <div class="max-w-5xl mx-auto">
                    <!-- Badge -->
                    <div class="inline-flex items-center gap-2 bg-orange-500/10 text-orange-400 px-6 py-3 rounded-full mb-8 border border-orange-500/30 pulse">
                        <span>⚡</span>
                        <span class="font-semibold">Lightning Network Active</span>
                    </div>

                    <h1 class="text-6xl md:text-8xl font-black mb-6">
                        <span class="bitcoin-gradient bg-clip-text text-transparent">Bitcoin Yields</span>
                    </h1>
                    <p class="text-2xl md:text-3xl text-gray-300 mb-4">
                        Earn 4-12% APY on Your Bitcoin. Automatically.
                    </p>
                    <p class="text-lg text-gray-400 mb-12 max-w-3xl mx-auto">
                        The first platform to bring Bitcoin yields to StarkNet. 
                        Lightning-fast deposits, zero complexity, maximum returns.
                    </p>

                    <!-- BTC Stats -->
                    <div class="grid md:grid-cols-4 gap-6 mb-12">
                        <div class="bg-black/50 backdrop-blur border border-orange-900/30 rounded-2xl p-6">
                            <div class="text-4xl font-bold text-orange-400 mb-2">₿ <span id="btc-price">65,432</span></div>
                            <div class="text-gray-400">BTC Price</div>
                        </div>
                        <div class="bg-black/50 backdrop-blur border border-orange-900/30 rounded-2xl p-6">
                            <div class="text-4xl font-bold text-orange-400 mb-2">12.5%</div>
                            <div class="text-gray-400">Max APY</div>
                        </div>
                        <div class="bg-black/50 backdrop-blur border border-orange-900/30 rounded-2xl p-6">
                            <div class="text-4xl font-bold text-orange-400 mb-2">₿21.4</div>
                            <div class="text-gray-400">Total BTC Locked</div>
                        </div>
                        <div class="bg-black/50 backdrop-blur border border-orange-900/30 rounded-2xl p-6">
                            <div class="text-4xl font-bold text-orange-400 mb-2">⚡ Instant</div>
                            <div class="text-gray-400">Lightning Deposits</div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Bitcoin Yield Strategies -->
            <section class="container mx-auto px-4 py-12">
                <h2 class="text-3xl font-bold text-center mb-12 text-orange-400">Bitcoin Yield Strategies</h2>
                <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
                    <!-- Lightning Routing -->
                    <div class="bg-black/50 backdrop-blur border border-orange-900/30 rounded-2xl p-6 hover:border-orange-500/50 transition">
                        <div class="text-3xl mb-4">⚡</div>
                        <h3 class="text-xl font-bold text-orange-400 mb-2">Lightning Routing</h3>
                        <p class="text-gray-400 text-sm mb-4">Earn fees by routing Lightning payments</p>
                        <div class="flex justify-between items-center mb-4">
                            <span class="text-green-400 font-bold">4.5% APY</span>
                            <span class="text-xs bg-green-900/30 text-green-400 px-2 py-1 rounded">Low Risk</span>
                        </div>
                        <button onclick="depositToBTCStrategy('lightning-routing')" class="w-full py-2 bg-orange-600/20 border border-orange-600 rounded-lg hover:bg-orange-600/30 transition">
                            Deposit BTC
                        </button>
                    </div>

                    <!-- Atomic Swaps -->
                    <div class="bg-black/50 backdrop-blur border border-orange-900/30 rounded-2xl p-6 hover:border-orange-500/50 transition">
                        <div class="text-3xl mb-4">🔄</div>
                        <h3 class="text-xl font-bold text-orange-400 mb-2">Atomic Swaps</h3>
                        <p class="text-gray-400 text-sm mb-4">Liquidity for BTC<>StarkNet bridge</p>
                        <div class="flex justify-between items-center mb-4">
                            <span class="text-yellow-400 font-bold">8.2% APY</span>
                            <span class="text-xs bg-yellow-900/30 text-yellow-400 px-2 py-1 rounded">Medium Risk</span>
                        </div>
                        <button onclick="depositToBTCStrategy('atomic-swaps')" class="w-full py-2 bg-orange-600/20 border border-orange-600 rounded-lg hover:bg-orange-600/30 transition">
                            Deposit BTC
                        </button>
                    </div>

                    <!-- BTC Lending -->
                    <div class="bg-black/50 backdrop-blur border border-orange-900/30 rounded-2xl p-6 hover:border-orange-500/50 transition">
                        <div class="text-3xl mb-4">🏦</div>
                        <h3 class="text-xl font-bold text-orange-400 mb-2">BTC Lending</h3>
                        <p class="text-gray-400 text-sm mb-4">Lend BTC via Vesu protocol</p>
                        <div class="flex justify-between items-center mb-4">
                            <span class="text-blue-400 font-bold">6.8% APY</span>
                            <span class="text-xs bg-green-900/30 text-green-400 px-2 py-1 rounded">Low Risk</span>
                        </div>
                        <button onclick="depositToBTCStrategy('btc-lending')" class="w-full py-2 bg-orange-600/20 border border-orange-600 rounded-lg hover:bg-orange-600/30 transition">
                            Deposit BTC
                        </button>
                    </div>

                    <!-- BTC-ETH LP -->
                    <div class="bg-black/50 backdrop-blur border border-orange-900/30 rounded-2xl p-6 hover:border-orange-500/50 transition">
                        <div class="text-3xl mb-4">💱</div>
                        <h3 class="text-xl font-bold text-orange-400 mb-2">BTC-ETH LP</h3>
                        <p class="text-gray-400 text-sm mb-4">Provide liquidity on JediSwap</p>
                        <div class="flex justify-between items-center mb-4">
                            <span class="text-purple-400 font-bold">12.5% APY</span>
                            <span class="text-xs bg-yellow-900/30 text-yellow-400 px-2 py-1 rounded">Medium Risk</span>
                        </div>
                        <button onclick="depositToBTCStrategy('btc-starknet-lp')" class="w-full py-2 bg-orange-600/20 border border-orange-600 rounded-lg hover:bg-orange-600/30 transition">
                            Deposit BTC
                        </button>
                    </div>
                </div>
            </section>

            <!-- How It Works -->
            <section class="container mx-auto px-4 py-20">
                <h2 class="text-3xl font-bold text-center mb-12 text-orange-400">How Bitcoin Yield Works</h2>
                <div class="max-w-4xl mx-auto grid md:grid-cols-2 gap-8">
                    <div class="space-y-6">
                        <div class="flex items-start gap-4">
                            <div class="w-10 h-10 bitcoin-gradient rounded-full flex items-center justify-center text-white font-bold flex-shrink-0">1</div>
                            <div>
                                <h3 class="font-bold mb-1">Connect Lightning Wallet</h3>
                                <p class="text-gray-400 text-sm">Use Alby, Zeus, or any WebLN wallet</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-4">
                            <div class="w-10 h-10 bitcoin-gradient rounded-full flex items-center justify-center text-white font-bold flex-shrink-0">2</div>
                            <div>
                                <h3 class="font-bold mb-1">Instant BTC Deposit</h3>
                                <p class="text-gray-400 text-sm">Lightning-fast, near-zero fees</p>
                            </div>
                        </div>
                    </div>
                    <div class="space-y-6">
                        <div class="flex items-start gap-4">
                            <div class="w-10 h-10 bitcoin-gradient rounded-full flex items-center justify-center text-white font-bold flex-shrink-0">3</div>
                            <div>
                                <h3 class="font-bold mb-1">Bridge to StarkNet</h3>
                                <p class="text-gray-400 text-sm">Atomiq SDK handles the complexity</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-4">
                            <div class="w-10 h-10 bitcoin-gradient rounded-full flex items-center justify-center text-white font-bold flex-shrink-0">4</div>
                            <div>
                                <h3 class="font-bold mb-1">Earn Yields 24/7</h3>
                                <p class="text-gray-400 text-sm">Auto-compound every 6 hours</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- CTA Section -->
            <section class="container mx-auto px-4 py-20 text-center">
                <div class="max-w-3xl mx-auto bg-gradient-to-r from-orange-900/30 to-yellow-900/30 rounded-3xl p-12 border border-orange-500/30">
                    <h2 class="text-4xl font-bold mb-6">Start Earning Bitcoin Yields Today</h2>
                    <p class="text-xl text-gray-300 mb-8">
                        Join the first platform bringing real Bitcoin yields to StarkNet
                    </p>
                    <div class="flex flex-col sm:flex-row gap-4 justify-center">
                        <button onclick="connectLightning()" class="px-8 py-4 bitcoin-gradient text-white rounded-xl font-bold text-lg hover:scale-105 transition">
                            ⚡ Connect Lightning Wallet
                        </button>
                        <button onclick="learnMore()" class="px-8 py-4 bg-black/50 border-2 border-orange-500 rounded-xl font-bold text-lg hover:bg-orange-950/30 transition">
                            📚 Learn More
                        </button>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <!-- Scripts -->
    <script src="bitcoin-integration.js"></script>
    <script src="starknet-integration.js"></script>
    <script>
        // Initialize Bitcoin Integration
        window.onload = async () => {
            console.log('⚡ Initializing Bitcoin Yield Platform...');
            
            // Initialize Atomiq SDK
            await window.BitcoinYield.initAtomiq();
            
            // Update BTC price
            updateBTCPrice();
            setInterval(updateBTCPrice, 30000); // Update every 30 seconds
        };

        async function updateBTCPrice() {
            const price = await window.BitcoinYield.getBTCPrice();
            document.getElementById('btc-price').textContent = 
                Math.round(price.usd).toLocaleString();
        }

        async function connectLightning() {
            try {
                console.log('Connecting Lightning wallet...');
                const result = await window.BitcoinYield.connectLightning();
                
                if (result.success) {
                    alert(`⚡ Lightning wallet connected!\nNode: ${result.alias}\nBalance: ${result.balance} sats`);
                    
                    // Redirect to dashboard
                    window.location.href = 'dashboard.html?bitcoin=true';
                }
            } catch (error) {
                alert('Please install a Lightning wallet like Alby to continue');
                window.open('https://getalby.com', '_blank');
            }
        }

        async function depositToBTCStrategy(strategyId) {
            const amount = prompt('Enter BTC amount to deposit (e.g., 0.01):');
            
            if (amount && !isNaN(amount)) {
                try {
                    const result = await window.BitcoinYield.depositBTC(
                        parseFloat(amount), 
                        strategyId
                    );
                    
                    alert(`✅ ${result.message}\n\nEstimated daily yield: ${result.dailyYield.toFixed(8)} BTC\nAPY: ${result.estimatedAPY}%`);
                } catch (error) {
                    alert(`Error: ${error.message}`);
                }
            }
        }

        function learnMore() {
            window.location.href = 'index.html#bitcoin-yield';
        }

        // Auto-compound notification
        setInterval(async () => {
            if (window.BitcoinYield.isConnected) {
                const result = await window.BitcoinYield.autoCompoundBTC();
                if (result.success && result.compounded > 0) {
                    console.log(`🔄 Auto-compounded ${result.compounded.toFixed(8)} BTC`);
                }
            }
        }, 6 * 60 * 60 * 1000); // Every 6 hours
    </script>
</body>
</html>